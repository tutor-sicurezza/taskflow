# Copia questo file in `.env.local` e riempilo con i TUOI valori.
# `.env.local` e' in .gitignore: non deve mai finire nel repository.

# --- Supabase, lette dal browser -------------------------------------------
# Finiscono nel bundle JavaScript, quindi qui vanno SOLO valori pubblici.
# Li trovi in: Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable / anon key>

# --- Supabase, lette solo dal server (funzioni in api/) ---------------------
# Stessi valori dei due sopra, senza prefisso VITE_, piu' la service role key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable / anon key>

# SEGRETO: scavalca tutte le policy RLS del progetto. Non deve MAI avere il
# prefisso VITE_ (finirebbe nel browser) ne' essere committata.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# --- Email (Resend) ---------------------------------------------------------
# Serve per le notifiche di assegnazione task. Senza, l'app funziona ma non
# manda email. Il mittente deve appartenere a un dominio verificato su Resend:
# con onboarding@resend.dev la consegna avviene solo verso il titolare
# dell'account.
RESEND_API_KEY=<chiave Resend>
EMAIL_FROM="TaskFlow <no-reply@tuodominio.it>"

# --- AI (opzionale) ---------------------------------------------------------
# Senza questa chiave le funzioni AI restano semplicemente nascoste: l'app
# funziona lo stesso.
ANTHROPIC_API_KEY=<chiave Anthropic>

# Necessaria SOLO se la chiave e' a livello di organizzazione e non e' legata a
# un workspace. In quel caso Anthropic rifiuta ogni richiesta con
# "This API key is not scoped to a workspace": imposta qui l'id del workspace
# oppure usa una chiave gia' associata a uno.
# ANTHROPIC_WORKSPACE_ID=<id del workspace>

# --- Solo per lo script di verifica scripts/smoke-auth.mjs ------------------
# Facoltative: se assenti, il controllo sugli account esistenti viene saltato.
# QA_ADMIN_EMAIL=
# QA_ADMIN_PASSWORD=
# QA_USER_EMAIL=
# QA_USER_PASSWORD=

# --- Lavori pianificati (cron di Vercel) ------------------------------------
# SEGRETO. Senza, tutte e cinque le rotte in api/cron/ rispondono 503 e non
# fanno nulla: promemoria, riepiloghi giornalieri, ricorrenze, archiviazione ed
# escalation smettono di funzionare IN SILENZIO, senza nessun errore visibile.
# Un valore lungo e casuale, per esempio `openssl rand -hex 32`.
CRON_SECRET=<stringa casuale lunga>

# Base dei collegamenti dentro le email. Senza, si ripiega su VERCEL_URL, cioe'
# l'indirizzo del singolo deploy: cambia a ogni pubblicazione e, con la
# protezione deploy attiva, chiede di autenticarsi prima di aprire il task.
APP_URL=https://tuodominio.it

# --- Email: alternativa a Resend --------------------------------------------
# Se presente, viene usata al posto di RESEND_API_KEY.
# SENDGRID_API_KEY=<chiave SendGrid>

# --- Tetti di spesa AI (opzionali, hanno gia' un valore predefinito) ---------
# AI_RATE_LIMIT_USER_HOUR=30
# AI_RATE_LIMIT_ORG_HOUR=200
# AI_TIMEOUT_MS=30000

# --- Solo per scripts/taskflow.mjs, la riga di comando ----------------------
# Non servono per l'uso normale: `accedi` chiede email e password una volta e
# ricorda la sessione. Queste servono alle esecuzioni automatiche, dove non
# c'e' nessuno a rispondere a una domanda.
# TASKFLOW_EMAIL=
# TASKFLOW_PASSWORD=
# Solo se l'account appartiene a piu' di un'organizzazione.
# TASKFLOW_ORG=<id organizzazione>
